// `shipping` schema — Shipment (services/shipping). Source of truth for carrier references,
// shipping labels, tracking history, delivery estimates, and the shipment/carrier-communication
// lifecycle. Distinct from `fulfillment` (pick/pack): this schema owns the *carrier* side.

model Shipment {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id")
  fulfillmentRef String   @map("fulfillment_ref") // bare id into Fulfillment — never an FK
  packages       Json // ShipmentPackage[] snapshot
  status         String // 13-value lifecycle union (domain-enforced, see ShipmentStatusValue)
  /// Caller-supplied idempotency key for shipment creation (Sprint A0 precondition, reintroduced
  /// here per this milestone's own additive migration rather than editing the frozen A0 migration
  /// file). Nullable — no code path writes it yet (the domain aggregate carries no such field);
  /// a future milestone threads it through `CreateShipment` to dedupe retried saga-activity calls.
  idempotencyKey String?  @map("idempotency_key")
  carrier        String?
  carrierService String?   @map("carrier_service")
  /// `{}`-means-unset (Sprint 4.6/4.8/4.9 convention) — never actually NULL.
  label            Json      @default("{}")
  trackingNumber   String?   @map("tracking_number")
  trackingEvents   Json      @default("[]") @map("tracking_events")
  deliveryEstimate Json      @default("{}") @map("delivery_estimate")
  deliveredAt      DateTime? @map("delivered_at")
  version          Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  attempts ShippingAttempt[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, fulfillmentRef])
  @@index([tenantId, status])
  @@map("shipments")
  @@schema("shipping")
}

/// Append-only lifecycle-attempt log (Sprint 4.10) — retry-safe observability trail, never rewritten.
model ShippingAttempt {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id")
  shipmentId String   @map("shipment_id") @db.Uuid
  kind       String
  outcome    String
  reference  String?
  occurredAt DateTime @map("occurred_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@map("shipping_attempts")
  @@schema("shipping")
}

/// Replay-safe carrier-webhook dedup (Sprint 4.10) — unique per (tenant, carrier, webhook_event_id).
/// Named distinctly from Payments' own `ProcessedWebhook` model (Prisma model names are global).
model ProcessedShippingWebhook {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id")
  carrier        String
  webhookEventId String   @map("webhook_event_id")
  receivedAt     DateTime @default(now()) @map("received_at")

  @@unique([tenantId, carrier, webhookEventId])
  @@map("processed_webhooks")
  @@schema("shipping")
}

/// Plan 3C — Shopify's shipping zone (Shipping and delivery → General shipping rates): a named set of
/// countries (and provinces) with the rates offered inside it. `countries` is
/// `[{ code, provinces: string[] | null }]` (`null` = the whole country, code `*` = rest of world).
/// `profile` is `general` for now; the column exists so custom profiles never reshape the table.
model ShippingZone {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id")
  profile   String   @default("general")
  name      String
  countries Json     @default("[]")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rates ShippingRate[]

  @@index([tenantId, profile])
  @@map("shipping_zones")
  @@schema("shipping")
}

/// Plan 3C — one price a shopper can pick, inside a zone. `condition_type` is none | order_price |
/// weight (CHECK + domain-enforced); the bounds are minor units (order_price) or grams (weight), the
/// minimum inclusive and the maximum exclusive.
model ShippingRate {
  id            String  @id @db.Uuid
  tenantId      String  @map("tenant_id")
  zoneId        String  @map("zone_id") @db.Uuid
  name          String
  priceMinor    Int     @map("price_minor")
  conditionType String  @default("none") @map("condition_type")
  conditionMin  BigInt? @map("condition_min")
  conditionMax  BigInt? @map("condition_max")
  description   String?
  position      Int     @default(0)

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([tenantId, zoneId])
  @@map("shipping_rates")
  @@schema("shipping")
}
