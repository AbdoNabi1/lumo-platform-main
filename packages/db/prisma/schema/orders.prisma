// `orders` schema — Order (+OrderItem, +OrderEvent) (services/orders).
// Order status is DERIVED from the append-only `order_events` history (never a column) —
// the financial record is the events, exactly like the aggregate (docs/architecture/03).

model Order {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id")
  orderNumber    String   @map("order_number")
  customerRef    String   @map("customer_ref") // bare id into Identity — never an FK
  currency       String
  checkoutRef    String?  @map("checkout_ref") // bare id into Checkout — never an FK
  paymentRef     String?  @map("payment_ref") // bare id into Payments — never an FK
  fulfillmentRef String?  @map("fulfillment_ref") // bare id into Fulfillment/Shipping — never an FK
  billingAddress Json?    @map("billing_address")
  totals         Json?
  version        Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  /// Order operations Part 1: Shopify's Archive. Outside the aggregate — never written by OrderMapper.
  archivedAt     DateTime? @map("archived_at")
  /// Order operations Part 2: the staff note. Outside the aggregate — never written by OrderMapper.
  note           String?

  items  OrderItem[]
  events OrderEvent[]
  tags   OrderTag[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, customerRef, createdAt])
  @@index([tenantId, archivedAt])
  @@map("orders")
  @@schema("orders")
}

/// Immutable product snapshot at order time (ADR-0001 trade-offs): no live Catalog reference.
model OrderItem {
  id                   String @id @db.Uuid
  tenantId             String @map("tenant_id")
  orderId              String @map("order_id") @db.Uuid
  productRef           String @map("product_ref") // snapshot of the bare id — never an FK
  name                 String
  unitPriceAmountMinor Int    @map("unit_price_amount_minor")
  quantity             Int
  /// Plan 2A: snapshot of the variant sold; null on orders placed before variants were tracked.
  variantRef           String? @map("variant_ref")
  sku                  String?
  variantTitle         String? @map("variant_title")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
  @@schema("orders")
}

/// Append-only lifecycle history. Legacy placed → paid → refunded, or the full Sprint 4.7
/// lifecycle (created → ... → closed). Never updated, never deleted.
model OrderEvent {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id")
  orderId    String   @map("order_id") @db.Uuid
  type       String // 21-value lifecycle union (domain-enforced, see OrderEventType)
  occurredAt DateTime @map("occurred_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, occurredAt])
  @@map("order_events")
  @@schema("orders")
}

/// Shipping-address snapshot, one owned row per order — kept off the hot `orders` row so
/// address PII stays isolated (simpler encryption/erasure scope) and order scans stay narrow.
model OrderShippingAddress {
  orderId    String @id @map("order_id") @db.Uuid
  tenantId   String @map("tenant_id")
  line1      String
  city       String
  postalCode String @map("postal_code")
  country    String
  recipientName String? @map("recipient_name") // Plan 3A
  phone         String? // Plan 3A
  line2         String? // Plan 3A
  province      String? // Plan 3C: ISO 3166-2 (EG-C); null before it was captured

  @@index([tenantId]) // Order operations Part 1: the recipient search joins by tenant
  @@map("order_shipping_addresses")
  @@schema("orders")
}

/// Order operations Part 2 — one tag on one order. `tag` is the spelling as typed (trimmed, inner
/// spaces collapsed); `tagKey` is its lower-case identity (dedupe, filter, suggestions). Outside the
/// aggregate. The relation exists for the list's tag filter (EXISTS), not for cascading.
model OrderTag {
  tenantId  String   @map("tenant_id")
  orderId   String   @map("order_id") @db.Uuid
  tag       String
  tagKey    String   @map("tag_key")
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@id([orderId, tagKey])
  @@index([tenantId, tagKey])
  @@map("order_tags")
  @@schema("orders")
}

/// Order operations Part 2 — staff comments and annotation activity on an order. `kind` is one of
/// comment | archived | unarchived | note_changed | tags_added | tags_removed | created_from_draft
/// (CHECK + domain-enforced). `authorName` is a snapshot. Comments are soft-deleted (`deletedAt`).
model OrderTimelineEntry {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id")
  orderId    String    @map("order_id") @db.Uuid // bare id — never an FK
  kind       String
  authorRef  String?   @map("author_ref")
  authorName String?   @map("author_name")
  body       String?
  data       Json      @default("{}")
  createdAt  DateTime  @map("created_at")
  editedAt   DateTime? @map("edited_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([orderId, createdAt])
  @@map("order_timeline_entries")
  @@schema("orders")
}

/// Plan 3B — the per-shop order number counter (1001, 1002, …). Bumped by one atomic raw upsert in
/// `PrismaOrderNumberAllocator`, inside the order's transaction; Prisma never reads or writes it.
model OrderNumberCounter {
  tenantId   String @id @map("tenant_id")
  lastNumber Int    @map("last_number")

  @@map("order_number_counters")
  @@schema("orders")
}
