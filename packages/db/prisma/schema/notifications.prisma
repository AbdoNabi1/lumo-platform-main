// `notifications` schema — Notification (services/notifications). Source of truth for the
// delivery lifecycle, delivery attempts/history, retry policy, template rendering, and channel
// routing. No contact PII (ADR-0006) — `recipient` stores a bare reference only.

model Notification {
  id             String @id @db.Uuid
  tenantId       String @map("tenant_id")
  idempotencyKey String @map("idempotency_key")
  sourceRef      String @map("source_ref") // bare id into whichever context triggered this — never an FK
  recipient      Json // { customerRef } — reference only, no contact address/PII
  channels       Json // NotificationChannel[] snapshot, priority order
  channelIndex   Int    @default(0) @map("channel_index")
  template       Json // { templateId, bodyPattern, subjectPattern? }
  variables      Json   @default("{}")
  policy         Json // { maxAttempts, expiresAt? }
  status         String // 9-value lifecycle union (domain-enforced, see NotificationStatusValue)
  /// Append-only provider-attempt log and lifecycle-status history — both embedded JSONB arrays on
  /// this row (unlike every prior context's separate `*_attempts` child table); never rewritten,
  /// only appended.
  attempts    Json      @default("[]")
  history     Json      @default("[]")
  deliveredAt DateTime? @map("delivered_at")
  version     Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, sourceRef])
  @@index([tenantId, status])
  @@map("notifications")
  @@schema("notifications")
}

/// Replay-safe provider-callback dedup (Sprint 4.12) — unique per (tenant, provider, callback_id).
model ProcessedProviderCallback {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id")
  provider   String
  callbackId String   @map("callback_id")
  receivedAt DateTime @default(now()) @map("received_at")

  @@unique([tenantId, provider, callbackId])
  @@map("processed_callbacks")
  @@schema("notifications")
}

// Wave 2b (Settings > Notifications): one row per tenant, created on the first save. A tenant with no
// row uses the in-code defaults. No customer address is stored (ADR-0006); `sender_email` and the
// staff recipients are the MERCHANT's own addresses.
model NotificationSettings {
  tenantId          String   @id @map("tenant_id")
  senderEmail       String?  @map("sender_email")
  staffRecipients   Json     @default("[]") @map("staff_recipients") // string[] of emails, max 10
  disabledTemplates String[] @default([]) @map("disabled_templates")
  version           Int      @default(1)
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("notification_settings")
  @@schema("notifications")
}

// A merchant's own subject/body for one template + language. Deleting the row = "revert to default".
model NotificationTemplateOverride {
  tenantId  String   @map("tenant_id")
  key       String
  locale    String // en | ar (CHECK in the migration)
  subject   String
  body      String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([tenantId, key, locale])
  @@map("notification_template_overrides")
  @@schema("notifications")
}

// Wave 2b2: the store's OWN email account (D46-D50). One row per tenant. `sealed_credentials` is the
// sealed envelope JSON `{v, alias, wrappedDek, ciphertext}` only: no key reference, never the key in
// clear. `secret_last4` is all of the key that is ever shown. kind/status CHECKs live in the migration.
model EmailConnection {
  tenantId          String    @id @map("tenant_id")
  kind              String // resend (CHECK in the migration)
  fromEmail         String    @map("from_email")
  sealedCredentials String    @map("sealed_credentials")
  secretLast4       String    @map("secret_last4")
  enabled           Boolean   @default(true)
  status            String // connected | failed (CHECK in the migration)
  lastError         String?   @map("last_error")
  lastErrorAt       DateTime? @map("last_error_at")
  verifiedAt        DateTime? @map("verified_at")
  version           Int       @default(1)
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("email_connections")
  @@schema("notifications")
}
