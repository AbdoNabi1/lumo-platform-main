// `wishlist` schema — Wishlist (services/wishlist). Owns no product data — items are bare refs
// only. Never mutates the cart directly (CartPort + event only).

model Wishlist {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id")
  customerRef String   @map("customer_ref")
  status      String // 2-value lifecycle union (domain-enforced, see WishlistStatusValue)
  /// The favorited/saved product refs — embedded JSONB array on this row.
  items       Json     @default("[]")
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, customerRef])
  @@map("wishlists")
  @@schema("wishlist")
}
