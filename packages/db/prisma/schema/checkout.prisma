// `checkout` schema — CheckoutSession (services/checkout).
//
// Snapshot columns (items/addresses/selections/totals) are JSONB. `{}` (empty object) means
// unset — never bare `null` — per the mapper's own convention (Sprint 4.6).

model CheckoutSession {
  id                String   @id @db.Uuid
  tenantId          String   @map("tenant_id")
  cartRef           String   @map("cart_ref") // bare id into Cart — never an FK
  customerRef       String?  @map("customer_ref") // bare id into Identity — never an FK; null for a guest checkout
  sessionRef        String   @map("session_ref") // bare session reference — present for guest and customer sessions alike
  contactEmail      String?  @map("contact_email") // where a guest's receipt goes; Identity resolves a guest customer from it (WP-1, G-52). Null on sessions created before it existed.
  currency          String
  state             String // started | locked | completed | failed | expired (domain-enforced)
  orderRef          String?  @map("order_ref") // bare id into Orders — never an FK
  items             Json     @default("[]")
  billingAddress    Json     @default("{}") @map("billing_address")
  shippingAddress   Json     @default("{}") @map("shipping_address")
  shippingSelection Json     @default("{}") @map("shipping_selection")
  paymentSelection  Json     @default("{}") @map("payment_selection")
  taxMinor          Int?     @map("tax_minor")
  discountMinor     Int?     @map("discount_minor")
  totals            Json     @default("{}")
  discounts         Json     @default("{}") // Phase 2: { codes, snapshot, rejectedAttempts, attemptsWindowStartedAt }; {} = none
  recoveredFromRef  String?  @map("recovered_from_ref") // Part 3: on a session a recovery link created — the abandoned session's id
  recoveredOrderRef String?  @map("recovered_order_ref") // Part 3: on the abandoned session once its recovery became an order
  draftTerms        Json     @default("{}") @map("draft_terms") // Part 4: a draft's fixed discount/shipping; {} = none
  marketingOptIn    Boolean? @map("marketing_opt_in") // Wave 2a: the shopper's tick of the marketing box; null = not asked
  version           Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([tenantId, cartRef])
  @@index([tenantId, sessionRef])
  @@index([tenantId, state])
  @@index([tenantId, state, updatedAt])
  @@map("checkout_sessions")
  @@schema("checkout")
}

// Part 3 (order operations): a link a shopper opens to resume a checkout (recovery) or to pay a draft
// (invoice, Part 4). Only the hex SHA-256 of the token is stored. `purpose` and the target rule are
// CHECK constraints in the migration (recovery ⇒ checkoutSessionId, invoice ⇒ draftOrderRef).
model CheckoutLink {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id")
  purpose           String // recovery | invoice
  tokenHash         String    @unique @map("token_hash")
  checkoutSessionId String?   @map("checkout_session_id") @db.Uuid // bare id into checkout_sessions — never an FK
  draftOrderRef     String?   @map("draft_order_ref")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  createdBy         String    @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  claimCount        Int       @default(0) @map("claim_count")
  lastClaimedAt     DateTime? @map("last_claimed_at")
  resultCheckoutRef String?   @map("result_checkout_ref")

  @@index([tenantId, checkoutSessionId])
  @@index([tenantId, draftOrderRef])
  @@map("checkout_links")
  @@schema("checkout")
}

// Wave 2a (Settings > Checkout and Customer accounts): one row per tenant, created on the first save.
// A tenant with no row behaves exactly as before. The mode columns, the cart limit range and the
// "no login requirement while accounts are off" rule are CHECK constraints in the migration; the
// domain (`validateCheckoutSettings`) refuses the same combinations first, with a message.
model CheckoutSettings {
  tenantId             String   @id @map("tenant_id")
  nameMode             String   @default("required") @map("name_mode") // required | optional
  phoneMode            String   @default("required") @map("phone_mode") // required | optional
  line2Mode            String   @default("optional") @map("line2_mode") // hidden | optional | required
  marketingEmailPrompt String   @default("hidden") @map("marketing_email_prompt") // hidden | show | preselect
  cartLineLimit        Int?     @map("cart_line_limit") // null = no limit; 1..999
  requireLogin         Boolean  @default(false) @map("require_login")
  accountsMode         String   @default("optional") @map("accounts_mode") // optional | disabled
  showAccountLink      Boolean  @default(true) @map("show_account_link")
  version              Int      @default(1)
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("checkout_settings")
  @@schema("checkout")
}
