    "@platform/health": "workspace:*",
    "@platform/utils": "workspace:*",
    "fastify": "^5.1.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@platform/eslint-config": "workspace:*",
    "@platform/tsconfig": "workspace:*",
    "@types/node": "^22.7.5",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
