{
  "name": "@platform/http",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP transport adapter (Fastify): versioned routes, zod validation, OpenAPI, tenant/auth/rate-limit/idempotency middleware, health/ready/metrics, error mapping (Sprint 2.6).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
