{
  "name": "@platform/collector",
  "version": "0.0.0",
  "private": true,
  "description": "Public tracking collector (P0-1) — the first-party HTTP entrance for browser-emitted events. Parses, validates, resolves client context, and publishes exactly one tracking.event.captured.v1. Never executes the pipeline.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@platform/clock": "workspace:*",
    "@platform/config": "workspace:*",
    "@platform/domain-events": "workspace:*",
    "@platform/health": "workspace:*",
    "@platform/id": "workspace:*",
    "@platform/kafka": "workspace:*",
    "@platform/messaging": "workspace:*",
    "@platform/tracking": "workspace:*",
    "@platform/utils": "workspace:*",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@platform/eslint-config": "workspace:*",
    "@platform/tsconfig": "workspace:*",
    "@types/node": "^22.7.5",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^9.13.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
