# ─────────────────────────────────────────────────────────────────────────────
# Environment example — copy to .env.local (never commit real values; NO secrets).
# Validated at boot by @platform/config (src/env.ts) and by apps/runtime/src/config.ts /
# apps/collector/src/main.ts (each entrypoint owns its own schema). See
# docs/development/SETUP.md.
#
# M-10 (audit): this file is cross-checked against every schema/`process.env` read in the
# codebase by `scripts/ops/check-env-docs.mjs`, run in CI (ci.yml) — a variable a running
# process actually requires can no longer go undocumented here without the build failing, and a
# variable documented here that nothing reads can no longer linger silently. See that script's
# ALLOWLIST for the few intentional exceptions (ops-only reference URLs, infra-script-only vars).
# ─────────────────────────────────────────────────────────────────────────────

# Runtime mode (Node convention)
NODE_ENV=development

# Deployment environment: local | development | staging | production
APP_ENV=local

# Logging verbosity: debug | info | warn | error
LOG_LEVEL=info

# Public base URL of the web app (exposed to the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web app port
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# Server-side infrastructure (validated by @platform/config/server). Values below
# match infrastructure/docker/docker-compose.yml for local dev. NO production secrets —
# those come from the secret manager / Vault. Any var also supports a `*_FILE` variant
# (Docker/K8s secrets), e.g. DATABASE_URL_FILE=/run/secrets/database_url.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL
# Phase A.43: in production (Supabase) DATABASE_URL is the Transaction Pooler connection
# (port 6543, pgbouncer transaction mode) used by the app at runtime; DIRECT_URL is Supabase's
# direct/session connection (port 5432) used only by Prisma migration tooling (`migrate`,
# `db pull`, `studio`) — see packages/db/prisma/schema/main.prisma. Locally both can be identical.
# C-01 (audit): DIRECT_URL is REQUIRED for every Prisma CLI invocation, not only when a pooled
# connection is actually in play — the CLI validates the full datasource block up front
# (scripts/ops/check-prisma-env.mjs enforces this in CI before any migrate command runs).
DATABASE_URL=postgresql://lumo:lumo@localhost:5432/lumo
DIRECT_URL=postgresql://lumo:lumo@localhost:5432/lumo
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Consumed by @platform/config/server's serverEnvSchema (packages/config/src/server/env.ts).
# NOT wired into apps/runtime's own config.ts — that entrypoint validates its own schema
# independently (see that file's header comment) and does not read this var.
DATABASE_LOG_QUERIES=false

# Redis
# Local Docker:    redis://localhost:6379
# Upstash (cloud): rediss://default:<password>@<host>:6379
#   Use the TLS (rediss://) *connection string*, not the Upstash REST URL — ioredis speaks the
#   Redis wire protocol, not HTTP. packages/redis/src/connection.ts sets lazyConnect, so a wrong
#   URL does not fail at boot: it surfaces later as /readyz 503 and failing rate-limit/idempotency
#   calls. Verify with a PING before trusting it.
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=lumo:

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=lumo
CLICKHOUSE_PASSWORD=lumo
CLICKHOUSE_DATABASE=lumo

# Object storage (S3-compatible / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_BUCKET_MEDIA=media
S3_BUCKET_EXPORTS=exports
S3_BUCKET_BACKUPS=backups

# pgAdmin (local-only operator UI; infrastructure/docker/docker-compose.yml's pgadmin service).
# Phase A.23: previously hardcoded a real personal email/password directly in the compose file
# (a committed-secret finding) — now sourced from here instead. Change these locally; never commit
# a real value even here (this file is the example, not the real .env).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Observability (OpenTelemetry) — shared service name; OTEL_TRACES_ENABLED/OTEL_METRICS_ENABLED
# below are also read directly by apps/runtime/src/config.ts (each runtime process suffixes its
# own role onto OTEL_SERVICE_NAME — see apps/runtime/src/telemetry.ts).
OTEL_SERVICE_NAME=lumo-service
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_ENABLED=false
OTEL_METRICS_ENABLED=false

# Backups (configuration only; execution operated outside the app). Consumed by
# @platform/config/server's serverEnvSchema (same not-wired-into-apps/runtime note as
# DATABASE_LOG_QUERIES above).
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_BUCKET=backups

# ─────────────────────────────────────────────────────────────────────────────
# Messaging (Redpanda + Debezium + Apicurio) — Sprint 2.2.5
# Host clients use the external listener (19092); in-cluster uses redpanda:9092.
# ─────────────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=lumo-local
CONNECT_URL=http://localhost:8083

# Phase A.23: apps/runtime's scheduler CDC watchdog (distinct from CONNECT_URL above, which
# register-connector.sh — a host-side shell script — reads; this is the typed app config
# apps/runtime/src/config.ts validates for the in-process watchdog job). Same Kafka Connect REST
# API, same default port. Leave unset to keep the watchdog job a no-op (local rarely needs it).
# KAFKA_CONNECT_URL=http://localhost:8083
# Comma-separated connector names the watchdog polls when KAFKA_CONNECT_URL is set.
KAFKA_CONNECT_CDC_CONNECTORS=lumo-outbox
# Watchdog poll interval — a ~45s+ Postgres outage reliably produces a terminal FAILED task.
CDC_WATCHDOG_INTERVAL_MS=30000
# Restart-loop guard: max automatic restarts per connector+task inside the rolling window below.
CDC_WATCHDOG_MAX_RESTARTS=5
CDC_WATCHDOG_RESTART_WINDOW_MS=3600000

# ─────────────────────────────────────────────────────────────────────────────
# Authentication (Ory Hydra/Kratos/Keto — Phase A.32; infrastructure/docker/docker-compose.yml
# "Identity & workflow plane". Values below are the local-compose defaults.)
# ─────────────────────────────────────────────────────────────────────────────
AUTH_ISSUER_URL=http://localhost:4444/
AUTH_JWKS_URL=http://localhost:4444/.well-known/jwks.json
# JWT audience claim every JwtVerifier checks (apps/runtime + admin-web's session verification).
AUTH_AUDIENCE=lumo-admin
AUTH_CLIENT_ID=lumo-admin-web
# AUTH_CLIENT_SECRET comes from the secret manager (supports AUTH_CLIENT_SECRET_FILE). No
# localhost/placeholder fallback outside APP_ENV=local|development (apps/admin-web/src/lib/env.ts).
KRATOS_PUBLIC_URL=http://localhost:4433
KRATOS_ADMIN_URL=http://localhost:4434
KETO_READ_URL=http://localhost:4466
KETO_WRITE_URL=http://localhost:4467

# ─────────────────────────────────────────────────────────────────────────────
# Payments (Stripe PSP adapter — C2-2). Both keys present ⇒ the real StripePaymentProvider;
# absent ⇒ Payments' InMemoryPaymentProvider (webhook verification always succeeds — apps/runtime
# refuses to boot on this fallback outside APP_ENV=local, see apps/runtime/src/api.ts).
# ─────────────────────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY comes from the secret manager (sk_test_... / sk_live_..., never live here)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET comes from the secret manager (whsec_...)
# STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE=https://api.stripe.com

# ─────────────────────────────────────────────────────────────────────────────
# Tracking ingest (P1.3 / C-07) — mounts the tracking.event.captured.v1 consumer in the worker.
# Default off: a runtime whose tracking registry has not been seeded would refuse every event
# rather than start. Turn on only once the registry is seeded (doc 12).
# ─────────────────────────────────────────────────────────────────────────────
TRACKING_INGEST_ENABLED=off
TRACKING_RULE_SET_KEY=tracking.routing.default
TRACKING_REGISTRY_POLL_MS=30000

# ─────────────────────────────────────────────────────────────────────────────
# Rate limiting / outbox retention (apps/runtime/src/config.ts)
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=300
OUTBOX_RETENTION_DAYS=7

# C-8: the worker publishes platform.outbox rows to Kafka on a timer. Turn this ON unless
# Debezium CDC is actually running against this database — otherwise nothing ever publishes the
# outbox and every event-driven consumer (Finance, Loyalty, Customer 360, Search) stays starved.
# Mutually exclusive with Debezium: running both double-publishes (harmless — consumers are
# idempotent per ADR-0005 — but wasteful).
OUTBOX_RELAY_ENABLED=false
OUTBOX_RELAY_INTERVAL_MS=2000
OUTBOX_RELAY_BATCH_SIZE=200

# Temporal (purchase saga worker; joins apps/runtime once its activities become composable — G-40)
TEMPORAL_ADDRESS=localhost:7233

# ─────────────────────────────────────────────────────────────────────────────
# Security — KMS / HSM / threat-intel provider selection (H-3 / G-SEC-2, apps/runtime/src/config.ts).
# Every group below is validated as all-or-nothing: selecting a provider without its required
# keys fails closed at boot rather than silently degrading cryptography (see config.ts's
# superRefine). Leave everything in this section unset/default to stay on the `local` no-op
# providers.
# ─────────────────────────────────────────────────────────────────────────────

# Which KMS/crypto provider backs Security's key operations: local (node:crypto) | vault | aws | gcp | azure
SECURITY_KMS_PROVIDER=local
# Optional HSM provider for hardware-backed signing: none | pkcs11 | cloudhsm | yubihsm
SECURITY_HSM_PROVIDER=none
# Comma-separated threat-intel feeds to fan out: abuseipdb, virustotal, alienvault-otx, cloudflare,
# crowdstrike, microsoft-defender (empty = the offline reference feed only)
SECURITY_THREAT_PROVIDERS=
# Activates the Security principal-provisioning consumer fleet (Identity events → RegisterPrincipal/
# AssignRole). Enable BEFORE SECURITY_ZERO_TRUST_ENFORCEMENT — enforcement fails closed against an
# unpopulated store.
SECURITY_PRINCIPAL_PROVISIONING=off
# Mounts SecurityPermissionGuard as the HTTP authorization point. NOT SUPPORTED YET — no entrypoint
# mounts the guard (config.ts's superRefine rejects this at boot regardless of value); left here so
# the variable is documented ahead of that wiring, not because setting it does anything today.
SECURITY_ZERO_TRUST_ENFORCEMENT=off
# Lifetime (seconds) of a federated session mirror (ADR-0031) — keep at or below the Kratos session
# lifetime.
SECURITY_SESSION_MIRROR_TTL_SECONDS=3600

# HashiCorp Vault Transit — required when SECURITY_KMS_PROVIDER=vault
# VAULT_ADDR=
# VAULT_TOKEN comes from the secret manager
VAULT_TRANSIT_MOUNT=transit
# VAULT_NAMESPACE=

# AWS KMS (SigV4) — required when SECURITY_KMS_PROVIDER=aws
# AWS_REGION=
# AWS_KMS_KEY_ID=
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN come from the secret manager

# Google Cloud KMS (bearer token via workload identity) — required when SECURITY_KMS_PROVIDER=gcp
# GCP_KMS_KEY_RESOURCE=
# GCP_KMS_ACCESS_TOKEN comes from the secret manager

# Azure Key Vault (OAuth2 client-credentials) — required when SECURITY_KMS_PROVIDER=azure
# AZURE_KEYVAULT_URL=
# AZURE_KEYVAULT_KEY_NAME=
# AZURE_OAUTH_TOKEN_URL=
# AZURE_OAUTH_CLIENT_ID=
# AZURE_OAUTH_CLIENT_SECRET comes from the secret manager
AZURE_OAUTH_SCOPE=https://vault.azure.net/.default

# HSM (PKCS#11 module path + per-target config; the native module lives in the deployment image)
# HSM_PKCS11_MODULE= — required when SECURITY_HSM_PROVIDER is any value other than none
# HSM_CLOUDHSM_CLUSTER_ID= — required when SECURITY_HSM_PROVIDER=cloudhsm
# HSM_YUBIHSM_CONNECTOR_URL= — required when SECURITY_HSM_PROVIDER=yubihsm

# Threat-intel feed credentials — each required only when its provider is listed in
# SECURITY_THREAT_PROVIDERS above.
# THREAT_ABUSEIPDB_API_KEY=
# THREAT_VIRUSTOTAL_API_KEY=
# THREAT_OTX_API_KEY=
# THREAT_CLOUDFLARE_ACCOUNT_ID=
# THREAT_CLOUDFLARE_API_TOKEN=
THREAT_CROWDSTRIKE_API_BASE=https://api.crowdstrike.com
# THREAT_CROWDSTRIKE_TOKEN_URL=
# THREAT_CROWDSTRIKE_CLIENT_ID=
# THREAT_CROWDSTRIKE_CLIENT_SECRET=
# THREAT_DEFENDER_TOKEN_URL=
# THREAT_DEFENDER_CLIENT_ID=
# THREAT_DEFENDER_CLIENT_SECRET=
# THREAT_DEFENDER_SCOPE=
# THREAT_DEFENDER_API_BASE=

# ─────────────────────────────────────────────────────────────────────────────
# Tenant configuration (ADR-0008 — single-tenant local default; the transport
# resolves tenants per request in multi-tenant deployments)
# ─────────────────────────────────────────────────────────────────────────────
TENANT_MODE=single
TENANT_DEFAULT_ID=tenant-local

# ─────────────────────────────────────────────────────────────────────────────
# Storefront → Runtime API (Phase 8; apps/storefront/src/lib/runtime-api.ts mints
# a dev-only Hydra client_credentials token, same flow as scripts/dev/mint-local-token.mjs)
# ─────────────────────────────────────────────────────────────────────────────
RUNTIME_API_URL=http://localhost:3080
HYDRA_ADMIN_URL=http://localhost:4445
HYDRA_PUBLIC_URL=http://localhost:4444

# ─────────────────────────────────────────────────────────────────────────────
# Ory Network (managed Ory) — the cloud alternative to the self-hosted Hydra/Kratos/Keto in
# infrastructure/docker/docker-compose.yml. On Ory Network every Hydra *Admin* and Keto
# permission endpoint is authenticated with a project API key; self-hosted Ory needs none.
#
# ORY_API_KEY absent  ⇒ self-hosted topology, calls go out unauthenticated (unchanged behaviour).
# ORY_API_KEY present ⇒ attached as `Authorization: Bearer` by apps/runtime/src/ory-fetch.ts and
#                        apps/admin-web/src/lib/auth/ory-admin.ts.
#
# Note KetoAccessControl (packages/auth/src/keto.ts) FAILS CLOSED on any non-200 — so a missing
# or wrong key does not error loudly, it silently denies every permission. Verify the key with a
# relation-tuple check before debugging anything else.
#
# On Ory Network all six URLs below are the same project base URL
# (https://<project-slug>.projects.oryapis.com); they differ only in the self-hosted topology.
# ─────────────────────────────────────────────────────────────────────────────
ORY_SDK_URL=
ORY_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Dashboard (apps/admin-web) → Runtime API (Orders productization phase). Reuses
# RUNTIME_API_URL/TENANT_DEFAULT_ID above. Phase A.32 wired real sign-in (Hydra/Kratos), so most
# requests now forward the logged-in staff member's own session token — ADMIN_API_TOKEN is only the
# fallback for contexts with no session (build-time rendering). Left empty here on purpose: absent,
# GET /orders correctly 401s and the Dashboard shows its Unauthorized state rather than demo data.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_API_TOKEN=

# Public storefront origin the admin sidebar's "Storefront" sales-channel link opens
# in a new tab (apps/admin-web/src/components/navigation.ts).
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# admin-web cookie scoping (Phase A.34 — A.33 P0 #6). Unset (host-only cookie) is correct for
# local dev — see infrastructure/docker/kratos/kratos.yml's doc comment on why that makes the
# login bridge work at :3100/:4433 without any of this. Production, where Hydra/Kratos/admin-web
# are genuinely different hosts, MUST set COOKIE_DOMAIN to the shared registrable parent domain
# (e.g. ".lumo.example.com") — and Kratos's SESSION_COOKIE_DOMAIN must match exactly.
# ─────────────────────────────────────────────────────────────────────────────
# COOKIE_DOMAIN=.lumo.example.com
COOKIE_SAME_SITE=lax

# ─────────────────────────────────────────────────────────────────────────────
# Tracking Collector (apps/collector) — public HTTP ingress for browser-emitted events. Every
# variable in this section is required at boot (no permissive default); the collector refuses to
# start rather than accept traffic it cannot publish or that CORS cannot legitimately scope.
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated `writeKey:tenantId` bindings (e.g. wk_live_xxx:tenant-a,wk_live_yyy:tenant-b)
COLLECTOR_WRITE_KEYS=wk_local:tenant-local
# Comma-separated allowed CORS origins — MUST NOT contain "*" (incompatible with credentialed CORS;
# see main.ts's boot-time check)
COLLECTOR_ALLOWED_ORIGINS=http://localhost:3000
# How many proxies this collector sits behind; 0 (default) ignores X-Forwarded-For entirely — the
# safe reading, since a wrong non-zero value makes the client IP attacker-controlled.
COLLECTOR_TRUSTED_PROXIES=0
COLLECTOR_SECURE_COOKIES=true
# COLLECTOR_COOKIE_DOMAIN=
