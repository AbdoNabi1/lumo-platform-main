{
  "name": "@platform/feature-registry",
  "version": "0.0.0",
  "private": true,
  "description": "Feature Registry bounded context (ADR-0027) — the single source of truth for every platform capability: FeatureDefinition with versioned-immutable history, category, visibility, dependencies, required plans/permissions/capabilities, deprecation, replacement, soft removal. Owns feature DEFINITIONS only — never feature state, subscriptions, or developer flags.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@platform/application": "workspace:*",
    "@platform/contracts": "workspace:*",
    "@platform/db": "workspace:*",
    "@platform/domain": "workspace:*",
    "@platform/domain-events": "workspace:*",
    "@platform/entitlement": "workspace:*",
    "@platform/messaging": "workspace:*",
    "@platform/repository": "workspace:*",
    "@platform/types": "workspace:*",
    "@platform/utils": "workspace:*"
  },
  "devDependencies": {
    "@platform/eslint-config": "workspace:*",
    "@platform/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
