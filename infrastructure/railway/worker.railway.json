{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infrastructure/docker/runtime.Dockerfile"
  },
  "deploy": {
    "preDeployCommand": "cd /app/apps/runtime && node --import tsx src/provision-topics.ts",
    "startCommand": "node --import tsx src/worker.ts",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
